# Copy to .env and adjust. .env is gitignored — never commit real values.
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
WEB_PORT=3000

POSTGRES_DB=tourdock
POSTGRES_USER=tourdock
POSTGRES_PASSWORD=change-me

# JWT signing key: a long random string (e.g. `openssl rand -base64 48`)
JWT_SIGNING_KEY=change-me-to-a-long-random-string

# Optional: creates an admin account on startup (use a strong password)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Seed fictional demo agencies and tours into an empty database (true/false)
SEED_DEMO_DATA=true

# Payment sandbox (shared by the API and the sandbox container)
PAYMENTS_API_KEY=change-me-sandbox-api-key
PAYMENTS_WEBHOOK_SECRET=change-me-to-a-long-random-webhook-secret
PAYMENTS_PORT=8090
# Public origin of the web app; the payment page may only send travelers back there (default http://localhost:$WEB_PORT)
# WEB_PUBLIC_ORIGIN=https://tourdock.example.com

# Object storage for photos (RustFS, S3-compatible)
STORAGE_ACCESS_KEY=tourdock-local
STORAGE_SECRET_KEY=change-me-storage-secret
STORAGE_PORT=9000

# Email: locally everything goes to Mailpit (web inbox on MAIL_UI_PORT). Sender address shown in emails.
MAIL_UI_PORT=8025
# EMAIL_FROM=noreply@tourdock.test

# Semantic search (optional): a Voyage AI key turns on free-text search (q). Without it search works as before.
# Store it without echoing it: scripts/set-env-key.sh VOYAGE_API_KEY
# A model key from MongoDB Atlas instead of the Voyage platform needs VOYAGE_BASE_URL=https://ai.mongodb.com/v1/
# VOYAGE_API_KEY=
# VOYAGE_BASE_URL=https://api.voyageai.com/v1/
# Voyage has no spending cap, so the API keeps its own: no more calls after this many tokens per model, ever (counted in
# the database). The default stays under the 200 million free tokens of a new account; the same key used elsewhere
# (local runs, evals) isn't counted here, hence the margin.
# VOYAGE_TOKEN_BUDGET=150000000
# New search vectors per visitor (IP); cached texts are free. Over the limit, search keeps its normal order.
# SEMANTIC_SEARCH_PER_MINUTE=20
# SEMANTIC_SEARCH_PER_DAY=200

# Travel assistant (optional): an Anthropic API key turns on the chat. Store it with scripts/set-env-key.sh ANTHROPIC_API_KEY.
# Use a key with a spending limit (prepaid credit, auto-reload off); the daily cap below bounds it further.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5
# ASSISTANT_MESSAGES_PER_DAY=300
# Per visitor (signed-in user or IP), so one person can't use up the day's cap for everyone: a few a minute, 30 a day.
# ASSISTANT_PER_MINUTE=6
# ASSISTANT_PER_DAY=30

# "Continue with Google" (optional, ADR 0029): a Google Cloud OAuth client of type "Web application", with the redirect
# URI <your origin>/api/auth/google/callback (e.g. http://localhost:3000/api/auth/google/callback). Store both with
# scripts/set-env-key.sh. Without them the button isn't shown.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OAuth for MCP clients (ADR 0028). Without these, token keys are new on every start and connected apps sign in again.
# One line each: the PEM with its line breaks written as \n.
#   OAUTH_SIGNING_KEY_PEM: openssl genrsa 2048 | awk '{printf "%s\\n", $0}'
#   OAUTH_ENCRYPTION_KEY:  openssl rand -base64 32
# OAUTH_SIGNING_KEY_PEM=
# OAUTH_ENCRYPTION_KEY=

# Observability (optional): send traces, metrics and logs to an OTLP endpoint, e.g. the local Aspire Dashboard:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889 docker compose --profile observability up
# OTEL_EXPORTER_OTLP_ENDPOINT=
# DASHBOARD_PORT=18888
# The compose network and the web container's fixed address (the only proxy the API trusts for X-Forwarded-For).
# COMPOSE_SUBNET=172.30.240.0/24
# WEB_CONTAINER_IP=172.30.240.10
# Proxies in front of port WEB_PORT whose X-Forwarded-For and X-Forwarded-Proto the edge may believe (space-separated
# CIDRs, quoted): every reverse proxy in front of the edge, replicas included (deploy/README.md).
# Anyone else's header is ignored. Default: nobody.
# TRUSTED_PROXIES="192.0.2.1/32 192.0.2.2/32"

# Deployment overlay only (deploy/compose.lan.yaml, used with /opt/tourdock/.env on the server).
# LAN_HOST builds http://LAN_HOST:9000 photo and :8090 checkout links when PUBLIC_BASE_URL is unset.
# LAN_HOST=192.0.2.10
# Public origin behind a reverse proxy that routes /checkout/... and /tour-photos/... (no trailing slash).
# PUBLIC_BASE_URL=https://tourdock.example.com
# Mark auth cookies Secure; set to true whenever PUBLIC_BASE_URL is https.
# AUTH_COOKIE_SECURE=true
# Real email through an SMTP relay (required by the overlay). Use a sending domain you control.
# SMTP_HOST=192.0.2.25
# SMTP_PORT=25
# EMAIL_FROM=noreply@mail.example.com
